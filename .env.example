# OpenAI (LangGraph diagnose/patch node)
OPENAI_API_KEY=

# Paths
TARGET_APP_ROOT=./examples/target_app
ERROR_LOG_PATH=./logs/app_errors.log
SANDBOX_ROOT=./examples/target_app

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=diagnostic

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=fastapi-logs
# Optional cloud key
QDRANT_API_KEY=

# Agent
MAX_RETRIES=3
LLM_MODEL=gpt-4o
