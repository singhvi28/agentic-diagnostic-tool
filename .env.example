# LLM providers — set LLM_PROVIDER to openai | gemini | cursor
LLM_PROVIDER=openai
# Optional override; otherwise defaults below are used
LLM_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# Paths
TARGET_APP_ROOT=./examples/target_app
TARGET_APP_IMPORT=examples.target_app.main:app
ERROR_LOG_PATH=./logs/app_errors.log
SANDBOX_ROOT=./examples/target_app
PATCH_BACKUP_ROOT=./patches

# Neo4j (code topology)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=diagnostic

# Postgres + pgvector (sessions, patches, semantic logs)
DATABASE_URL=postgresql+psycopg://diagnostic:diagnostic@localhost:5433/diagnostic
EMBEDDING_DIM=384
# hash | openai | gemini | fastrp | auto
# Without an API key, FastRP (Neo4j GDS) is preferred over hash when available.
EMBEDDING_PROVIDER=hash

# Agent
MAX_RETRIES=3

# LangGraph → FastMCP (stdio spawns diagnostic-mcp; http connects to MCP_URL)
# Values: stdio | http | inprocess (tests only)
MCP_TRANSPORT=stdio
MCP_URL=http://127.0.0.1:8000/mcp
MCP_STDIO_COMMAND=diagnostic-mcp
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
